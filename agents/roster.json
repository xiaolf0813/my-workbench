{
  "agents": {
    "designer": {
      "description": "Pure UI design specialist. Produces design specs and self-contained HTML mockups that show how interfaces should look, feel, and behave - never edits app source. Use before implementing new screens, redesigns, or visual polish; fixer implements the design in the app. Not for implementation of any kind.",
      "frontmatter": {
        "claude": [
          "name: designer",
          "@description",
          "tools: Read, Write, Edit, Glob, Grep, Skill",
          "model: opus"
        ],
        "opencode": [
          "@description",
          "model: openai/gpt-5.6-terra",
          "mode: subagent",
          "tools:",
          "  ast_grep_replace: false"
        ],
        "zcode": [
          "name: designer",
          "@description",
          "model: inherit",
          "injectAgentsMd: false",
          "tools:",
          "  - Read",
          "  - Write",
          "  - Edit",
          "  - Glob",
          "  - Grep",
          "  - Bash",
          "  - Skill"
        ],
        "openbitfun": [
          "schema_version: 1",
          "kind: subagent",
          "id: designer",
          "name: Designer",
          "@description",
          "tools:",
          "  - Read",
          "  - Glob",
          "  - Grep",
          "  - Write",
          "  - Edit",
          "  - Skill",
          "  - ExecCommand",
          "readonly: false"
        ]
      }
    },
    "explorer": {
      "description": "Fast codebase search and pattern matching specialist. Use PROACTIVELY for finding files, locating code patterns, and answering \"where is X?\" questions when scope is broad or uncertain, before planning or editing.",
      "frontmatter": {
        "claude": [
          "name: explorer",
          "@description",
          "tools: Glob, Grep, Read, Bash",
          "model: haiku"
        ],
        "opencode": [
          "@description",
          "model: openai/gpt-5.6-luna",
          "mode: subagent",
          "tools:",
          "  write: false",
          "  edit: false",
          "  patch: false"
        ],
        "zcode": [
          "name: explorer",
          "@description",
          "model: inherit",
          "injectAgentsMd: false"
        ],
        "openbitfun": [
          "schema_version: 1",
          "kind: subagent",
          "id: explorer",
          "name: Explorer",
          "@description",
          "tools:",
          "  - Read",
          "  - Glob",
          "  - Grep",
          "  - ExecCommand",
          "readonly: true"
        ]
      }
    },
    "fixer": {
      "description": "Fast implementation specialist. Receives complete context and a task spec from the orchestrator, then executes bounded code changes efficiently. Use for well-defined mechanical or multi-file edits with parallelizable scope, including UI implementation from a designer mockup/spec. Not for research, architecture, debugging strategy, or authoring visual designs (commission designer first).",
      "frontmatter": {
        "claude": [
          "name: fixer",
          "@description",
          "tools: Read, Write, Edit, Glob, Grep, Bash, NotebookEdit",
          "model: sonnet"
        ],
        "opencode": [
          "@description",
          "model: zhipuai-coding-plan/glm-5.3-flash",
          "mode: subagent"
        ],
        "zcode": [
          "name: fixer",
          "@description",
          "model: inherit",
          "injectAgentsMd: false"
        ],
        "openbitfun": [
          "schema_version: 1",
          "kind: subagent",
          "id: fixer",
          "name: Fixer",
          "@description",
          "tools:",
          "  - Read",
          "  - Glob",
          "  - Grep",
          "  - Write",
          "  - Edit",
          "  - ExecCommand",
          "readonly: false"
        ]
      }
    },
    "librarian": {
      "description": "External documentation and library research specialist. Use PROACTIVELY when working with unfamiliar libraries, fast-moving APIs (React, Next.js, AI SDKs, ORMs, auth), version-specific behavior, edge cases, or tricky bugs that need current official docs, GitHub examples, or web research.",
      "frontmatter": {
        "claude": [
          "name: librarian",
          "@description",
          "tools: WebSearch, WebFetch, Bash, Read, Grep, Glob",
          "model: sonnet"
        ],
        "opencode": [
          "@description",
          "model: zhipuai-coding-plan/glm-5.3-flash",
          "mode: subagent",
          "tools:",
          "  write: false",
          "  edit: false",
          "  patch: false"
        ],
        "zcode": [
          "name: librarian",
          "@description",
          "model: inherit",
          "injectAgentsMd: false"
        ],
        "openbitfun": [
          "schema_version: 1",
          "kind: subagent",
          "id: librarian",
          "name: Librarian",
          "@description",
          "tools:",
          "  - WebSearch",
          "  - WebFetch",
          "  - Read",
          "  - Glob",
          "  - Grep",
          "  - ExecCommand",
          "readonly: true"
        ]
      }
    },
    "observer": {
      "description": "Visual analysis specialist. Use when a task involves images, screenshots, PDFs, or diagrams - extracts structured observations (UI elements, layouts, exact text via OCR) without loading raw image/PDF bytes into the orchestrator context. Always pass the full file path in the prompt. Requires a vision-capable model.",
      "frontmatter": {
        "claude": [
          "name: observer",
          "@description",
          "tools: Read, Glob, Grep",
          "model: sonnet"
        ],
        "opencode": [
          "@description",
          "mode: subagent",
          "tools:",
          "  write: false",
          "  edit: false",
          "  patch: false",
          "  bash: false"
        ],
        "zcode": [
          "name: observer",
          "@description",
          "model: inherit",
          "injectAgentsMd: false"
        ],
        "openbitfun": [
          "schema_version: 1",
          "kind: subagent",
          "id: observer",
          "name: Observer",
          "@description",
          "tools:",
          "  - Read",
          "  - Glob",
          "  - Grep",
          "  - view_image",
          "  - analyze_image",
          "readonly: true"
        ]
      }
    },
    "sentinel": {
      "description": "Independent senior reviewer for high-risk changes and stuck debugging. Use ONLY as an escalation: gatekeeping a high-risk multi-system refactor (assessing the plan before dispatch or reviewing the delivered change) or re-deriving a debugging strategy after 2+ failed fix attempts. Not for routine reviews, first attempts, or general architecture questions - the orchestrator owns those.",
      "frontmatter": {
        "claude": [
          "name: sentinel",
          "@description",
          "tools: Glob, Grep, Read, Bash",
          "model: opus"
        ],
        "opencode": [
          "@description",
          "model: openai/gpt-5.6-sol",
          "mode: subagent",
          "tools:",
          "  write: false",
          "  edit: false",
          "  patch: false"
        ],
        "zcode": [
          "name: sentinel",
          "@description",
          "model: inherit",
          "injectAgentsMd: false"
        ],
        "openbitfun": [
          "schema_version: 1",
          "kind: subagent",
          "id: sentinel",
          "name: Sentinel",
          "@description",
          "tools:",
          "  - Read",
          "  - Glob",
          "  - Grep",
          "  - ExecCommand",
          "readonly: true"
        ]
      }
    },
    "orchestrator": {
      "description": "Multi-agent workflow manager and senior technical advisor - plans, schedules, delegates, monitors, reconciles, and verifies specialist-agent work; analyzes, decides, and reviews but never implements (purely mechanical doc/config touches excepted). Set as the main-thread agent via settings.json (\"agent\": \"orchestrator\"); routes every implementation lane - however small - to explorer/librarian/sentinel/designer/fixer/observer.",
      "frontmatter": {
        "claude": [
          "name: orchestrator",
          "@description",
          "model: inherit"
        ],
        "opencode": [
          "@description",
          "model: zhipuai-coding-plan/glm-5.3",
          "mode: all"
        ],
        "openbitfun": [
          "schema_version: 1",
          "kind: mode",
          "id: orchestrator",
          "name: Orchestrator",
          "@description",
          "tools:",
          "  - Read",
          "  - Glob",
          "  - Grep",
          "  - Write",
          "  - Edit",
          "  - Skill",
          "  - ExecCommand",
          "  - Task",
          "  - AgentWait",
          "  - TodoWrite",
          "  - AskUserQuestion",
          "  - WebSearch",
          "  - WebFetch",
          "  - view_image",
          "  - analyze_image",
          "  - get_goal",
          "  - create_goal",
          "  - update_goal",
          "readonly: false"
        ]
      }
    },
    "improver": {
      "description": "Retrospective analyst for agent failures: traces which agent produced unsatisfactory completed work, diagnoses the root cause, and proposes omos prompt/config fixes pending user confirmation. Use ONLY when the user reports that previously completed work is wrong or unsatisfactory - not for ordinary code bugs, new feature work, or in-progress verification.",
      "frontmatter": {
        "claude": [
          "name: improver",
          "@description",
          "tools: Read, Glob, Grep",
          "model: opus"
        ],
        "opencode": [
          "@description",
          "model: openai/gpt-5.6-sol",
          "mode: subagent",
          "tools:",
          "  write: false",
          "  edit: false",
          "  patch: false",
          "  bash: false"
        ],
        "zcode": [
          "name: improver",
          "@description",
          "model: inherit",
          "injectAgentsMd: false"
        ],
        "openbitfun": [
          "schema_version: 1",
          "kind: subagent",
          "id: improver",
          "name: Improver",
          "@description",
          "tools:",
          "  - Read",
          "  - Glob",
