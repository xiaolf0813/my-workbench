{
  "name": "my-workbench",
  "version": "0.13.0",
  "description": "Portable OpenCode + Claude Code agent setup: copies the .opencode/ and .claude/ agent configuration into your project (or user level with --user).",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaolf0813/my-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/xiaolf0813/my-workbench/issues"
  },
  "bin": {
    "my-workbench": "bin/my-workbench.js"
  },
  "files": [
    "bin/",
    "agents/roster.json",
    "agents/prompts/",
    "agents/disciplines.md",
    "agents/backends/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/dsh-deps.test.js",
    "goldens": "cargo test -p workbench-core --test golden_end_to_end",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  },
  "keywords": [
    "opencode",
    "claude",
    "claude-code",
    "agents",
    "oh-my-opencode",
    "openbitfun",
    "scaffold"
  ]
}
