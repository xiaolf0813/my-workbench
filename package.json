{
  "name": "my-workbench",
  "version": "0.14.0",
  "description": "Portable agent setup: installs OpenCode, Claude Code, ZCode and ChatGPT / Codex configs at user level.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaolf0813/my-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/xiaolf0813/my-workbench/issues"
  },
  "bin": {
    "my-workbench": "bin/my-workbench.js"
  },
  "files": [
    "bin/",
    "backends/codex/roster.json",
    "agents/prompts/",
    "agents/disciplines.md",
    "backends/codex/AGENTS.md",
    "backends/codex/leaf.md",
    "backends/codex/slots/",
    "backends/codex/subagent-config-marketplace/.agents/plugins/marketplace.json",
    "backends/codex/subagent-config/plugin.json",
    "backends/codex/subagent-config/assets/icon.png",
    "backends/codex/subagent-config/assets/logo.png",
    "backends/codex/subagent-config/assets/keyring/licenses/",
    "backends/codex/subagent-config/assets/third-party-licenses/",
    "backends/codex/subagent-config/mcp.json",
    "backends/codex/subagent-config/runtime/",
    "backends/codex/subagent-config/server/infrastructure/root-statements.js",
    "backends/claude/",
    "backends/opencode/",
    "backends/zcode/",
    "agents/solutions/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:subagent-config": "npm test --prefix backends/codex/subagent-config",
    "verify": "npm run test:subagent-config && node bin/my-workbench.js assemble --check && npm test"
  },
  "keywords": [
    "opencode",
    "claude",
    "claude-code",
    "agents",
    "oh-my-opencode",
    "scaffold"
  ]
}
